// Probando el poder total de Kriptia

mostrar("--- BIENVENIDO A FrecuenciaLatina ---")

// 1. Probando entrada por teclado
variable oyentes = leer("¿Cuántos oyentes hay conectados ahora?: ")

si oyentes > 10 entonces
    mostrar("¡Excelente sintonía en vivo!")
sino
    mostrar("Audiencia baja, toca subir el volumen.")
fin

// 2. Probando bucles (mientras)
mostrar("Iniciando cuenta regresiva de prueba:")
variable contador = 3
mientras contador > 0 repetir
    mostrar(contador)
    contador = contador - 1
fin
mostrar("¡Al aire!")

// 3. Probando funciones personalizadas
funcion saludarOyente(nombre)
    mostrar("¡Un saludo muy especial para nuestro oyente: " + nombre + "!")
fin

saludarOyente("Yaisel")
